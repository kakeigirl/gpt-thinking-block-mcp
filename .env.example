# Tool-schema language: en or zh-CN
THINKING_PROMPT_LANGUAGE=en

# Thinking content is not saved unless capture is explicitly enabled.
CAPTURE_ENABLED=0

# Directory for captured output. Defaults to the server's own directory.
# CAPTURE_DIR=

# Host port published by docker-compose.
# PORT=8787

# Address the server binds to. Loopback by default; exposure, TLS, and
# authentication belong to the deployment. Under docker-compose this is set
# inside the container and the port mapping is the exposure boundary instead.
# MCP_BIND=127.0.0.1

# Optional durable archive database (Neon PostgreSQL).
# When set, every new thinking block is saved to the database.
# DATABASE_URL=postgresql://...
#
# Protect the archive dashboard with a long random password.
# Set both values in the Render dashboard, never commit real credentials.
# ARCHIVE_ADMIN_USER=archive
# ARCHIVE_ADMIN_PASSWORD=
#
# Maximum accepted thinking text length.
# ARCHIVE_MAX_CONTENT_CHARS=100000
